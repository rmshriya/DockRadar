FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp STREAMLIT_BROWSER_GATHER_USAGE_STATS=false EGRESSEYE_DATA_DIR=/data EGRESSEYE_POLICY=/config/policy.json
WORKDIR /app
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && adduser --disabled-password --gecos "" --uid 10001 appuser \
    && mkdir -p /data
COPY dashboard.py detector.py policy.py simulator.py delivery_gate.py ./
RUN chown -R 10001:10001 /data
USER 10001:10001
EXPOSE 8501
CMD ["streamlit", "run", "dashboard.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
