FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 EGRESSEYE_DATA_DIR=/data EGRESSEYE_POLICY=/config/policy.json
WORKDIR /app
RUN adduser --disabled-password --gecos "" --uid 10001 appuser && mkdir -p /data
COPY policy.py detector.py egress_proxy.py ./
RUN chown -R 10001:10001 /data
USER 10001:10001
EXPOSE 3128
CMD ["python", "egress_proxy.py"]
